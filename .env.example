# Copy this file to .env (it is gitignored).

# OAuth 2.0 'Web application' client ID of this Firebase project (required for
# Google Sign-In on Android). Find it in Firebase → Project settings → General,
# or in the "client_type": 3 entry of android/app/google-services.json.
GOOGLE_WEB_CLIENT_ID=

# Backend base URL. Leave unset for the platform default (Android emulator
# 10.0.2.2, everything else localhost). Set it for a physical device:
# BACKEND_URL=http://192.168.1.20:8787
