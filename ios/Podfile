# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# React Native Firebase resolves firebase-ios-sdk via Swift Package Manager by
# default. SPM products are automatic libraries, so with static framework
# linkage every RNFirebase pod embeds its own Firebase copy and the duplicates
# collide at link time. Force classic CocoaPods resolution instead.
# Must be set before any target block / RNFirebase podspec evaluation.
$RNFirebaseDisableSPM = true

# Pin the firebase-ios-sdk family for ALL @react-native-firebase pods.
# RNFB reads this env var in its podspecs (RNFBApp.podspec). 12.2.0 is the
# last early-12.x with the classic ObjC header layout: newer 12.x (12.13+)
# moved FIRAuthErrorCode* behind a generated Swift header that does not
# resolve when RNFirebase pods build as static libraries.
# NOTE: 12.2.1 does not exist as a published pod version.
ENV['FIREBASE_SDK_VERSION'] = '12.2.0'

platform :ios, min_ios_version_supported
prepare_react_native_project!

use_frameworks! :linkage => :static

target 'NimChatApp' do
  config = use_native_modules!

  # With use_frameworks! :linkage => :static, Swift Firebase pods need module
  # maps from their Objective-C dependencies. These pods don't emit them by
  # default, so enable modular headers for exactly those listed by
  # `pod install` (avoids the heavier global use_modular_headers!).
  pod 'GoogleUtilities', :modular_headers => true
  pod 'RecaptchaInterop', :modular_headers => true
  pod 'FirebaseAuthInterop', :modular_headers => true
  pod 'FirebaseAppCheckInterop', :modular_headers => true
  pod 'FirebaseFirestoreInternal', :modular_headers => true
  pod 'FirebaseCore', :modular_headers => true
  pod 'FirebaseCoreExtension', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
