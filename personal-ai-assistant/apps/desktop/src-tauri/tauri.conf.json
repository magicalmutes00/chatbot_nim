{
  "productName": "Aurora",
  "version": "0.1.0",
  "identifier": "com.aurora.app",
  "build": {
    "beforeDevCommand": "node scripts/ensure-web.mjs",
    "beforeBuildCommand": "npm --prefix ../web run build:desktop",
    "devUrl": "http://localhost:5175",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
