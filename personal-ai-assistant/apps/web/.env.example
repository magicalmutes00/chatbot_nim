# Firebase web app config — public identifiers, not secrets.
# Firebase console → Project settings → Your apps → Web app → SDK setup.
# Enable Email/Password + Google under Authentication → Sign-in method, and add
# localhost (and tauri.localhost for the desktop build) to Authorized domains.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Packaged desktop only: absolute API origin (web dev uses the Vite proxy).
# VITE_API_BASE=http://localhost:8787
